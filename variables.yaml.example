---
# =============================================================================
# EXTERNAL CREDENTIALS FILE — Manage all secrets here (use ansible-vault encrypt)
# =============================================================================
# Usage:
#   1. Copy this file to credentials.yaml
#   2. Fill in your real values
#   3. Encrypt: ansible-vault encrypt credentials.yaml
#   4. Run playbooks with: ansible-playbook -i hosts site.yml --ask-vault-pass
#
# All playbooks include this file via: vars_files: [ "credentials.yaml" ]
# =============================================================================

# --- Cluster Identity ---
patroni_scope: "kyc"
patroni_namespace: "percona_lab"
cluster_name: "cluster_1"

# --- PostgreSQL / Patroni Users ---
# Superuser (postgres) - full admin access
postgres_password: "CHANGE_ME_POSTGRES_PASSWORD"

# Replication user - streaming replication between nodes
replicator_username: "replicator"
replicator_password: "CHANGE_ME_REPLICATOR_PASSWORD"

# Patroni admin user - cluster management via REST API
patroni_admin_username: "admin"
patroni_admin_password: "CHANGE_ME_ADMIN_PASSWORD"

# Percona monitoring user (used by Patroni for health checks)
percona_username: "percona"
percona_password: "CHANGE_ME_PERCONA_PASSWORD"

# pgpool monitoring user - used by pgpool for health checks
pgpool_username: "pgpool"
pgpool_password: "CHANGE_ME_PGPOOL_PASSWORD"

# --- Pgpool-II Users ---
# PCP admin user - for pcp_* control commands
pcp_user: "pgpool_pcp"
pcp_password: "CHANGE_ME_PCP_PASSWORD"

# Pgpool health check user (same as pgpool_username/pgpool_password above)
health_check_user: "pgpool"
health_check_password: "{{ pgpool_password }}"

# Pgpool admin user - for direct psql connections via the VIP
# Used by 04_Configure_Pgpool.yml (admin user created on PostgreSQL)
pgpool_admin_user: "pgpool_admin"
pgpool_admin_password: "CHANGE_ME_PGPOOL_ADMIN_PASSWORD"

# --- pgBackRest ---
pgbackrest_stanza: "kyc"
pgbackrest_repo_path: "/postgres/pgbackup"

# --- PMM (Percona Monitoring & Management) ---
pmm_admin_password: "CHANGE_ME_PMM_ADMIN_PASSWORD"
pg_pmm_user_password: "CHANGE_ME_PG_PMM_PASSWORD"

# --- Network / VIP ---
vip_address: "192.168.122.200"
# Optional: force a specific NIC for the VIP. Omit to auto-detect the default
# interface (eth0 on CentOS Stream 9, enp3s0/enp1s0 on Debian 12).
# vip_interface_override: "eth0"
vip_cidr: "24"
pgpool_port: 9999
pcp_port: 9898
wd_port: 9000

# Watchdog priority base - used to compute per-node watchdog priorities
# (higher = more likely to become watchdog leader). Set to 1 on a 3-node cluster.
wd_priority_base: 1

# --- PostgreSQL Version ---
pg_version: "16"

# --- Data Directories (OS-specific defaults, override if needed) ---
# RHEL/CentOS defaults:
data_dir_redhat: "/var/lib/pgsql/{{ pg_version }}/data/{{ patroni_scope }}"
pg_bin_dir_redhat: "/usr/pgsql-{{ pg_version }}/bin"
pg_service_redhat: "postgresql-{{ pg_version }}"
patroni_bin_redhat: "/usr/bin/patroni"
pgpool_conf_dir_redhat: "/etc/pgpool-II"
pgpool_service_redhat: "pgpool"
pgpool_log_dir_redhat: "/var/log/pgpool"
postgres_home_redhat: "/var/lib/pgsql"

# Debian/Ubuntu defaults:
data_dir_debian: "/postgres/data/{{ pg_version }}/{{ patroni_scope }}"
pg_bin_dir_debian: "/usr/lib/postgresql/{{ pg_version }}/bin"
pg_service_debian: "postgresql"
patroni_bin_debian: "/bin/patroni"
pgpool_conf_dir_debian: "/etc/pgpool2"
pgpool_service_debian: "pgpool2"
pgpool_log_dir_debian: "/var/log/pgpool2"
postgres_home_debian: "/var/lib/postgresql"

# --- etcd ---
etcd_token: "PostgreSQL_HA_Cluster_1"
etcd_data_dir: "/var/lib/etcd"
etcd_endpoints: "http://192.168.122.150:2379,http://192.168.122.151:2379,http://192.168.122.152:2379"

# --- Percona Repo ---
percona_repo_deb_url: "https://repo.percona.com/apt/percona-release_latest.generic_all.deb"
percona_repo_rpm_url: "https://repo.percona.com/yum/percona-release-latest.noarch.rpm"

# --- Docker / PMM Server ---
pmm_server_version: "3"
pmm_server_image: "perconalab/pmm-server:{{ pmm_server_version }}"
pmm_server_port: 443